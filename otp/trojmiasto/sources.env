# Tricity: one OTP graph with independent agency feeds (no destructive ID rewriting).
# OTP can read multiple GTFS archives; the FastAPI static stop index is still
# limited to the ZTM Gdańsk primary copy until a multi-feed API importer is added.
GTFS_SOURCES='gdansk|https://ckan.multimediagdansk.pl/dataset/c24aa637-3619-4dc2-a171-a23eec8f2172/resource/30e783e4-2bec-4a7d-bb22-ee3e3b26ca96/download/gtfsgoogle.zip
gdynia|http://api.zdiz.gdynia.pl/pt/gtfs.zip
skm|https://www.skm.pkp.pl/gtfs-mi-kpd.zip
polregio|https://transfer.polregio.pl/public/file/2xpjhbomseoindotgttcsg/GTFS.zip'
PRIMARY_GTFS_FEED="gdansk"
OSM_URL="https://download.geofabrik.de/europe/poland/pomorskie-latest.osm.pbf"
BBOX="18.15,53.95,19.05,54.87"
BUILD_HEAP="12G"
