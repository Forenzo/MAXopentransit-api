{
  "server": {
    "apiProcessingTimeout": "30s"
  },
  "routingDefaults": {
    "maxDirectStreetDuration": "PT3H"
  },
  "updaters": [
    {
      "type": "stop-time-updater",
      "frequency": "30s",
      "url": "http://ckan2.multimediagdansk.pl/gtfs-rt?feed=tripUpdates",
      "feedId": "gdansk",
      "backwardsDelayPropagationType": "ALWAYS"
    },
    {
      "type": "vehicle-positions",
      "frequency": "30s",
      "url": "http://ckan2.multimediagdansk.pl/gtfs-rt?feed=vehiclePositions",
      "feedId": "gdansk",
      "fuzzyTripMatching": false,
      "features": [
        "position"
      ]
    }
  ]
}
